store-procedure fac0 %n
  local %res
  set %res 0

  !if &equ 1 %n
    !return 1
  !else
    !return &tim %n &call fac0 &sub %n 1 
  !endif
!endm

store-procedure fac1 %n
  local %res
  local %i
  set %i   1
  set %res %i

  !while &les %i %n
    set %i &add %i 1
    set %res &tim %res %i
  !endwhile

  !return %res
!endm

