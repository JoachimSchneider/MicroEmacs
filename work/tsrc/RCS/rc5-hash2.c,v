VOID RC5_INIT(WORD_T_ *S)
{
    int     i = 0;
    int     k = 0;
    WORD_T_ A = 0;
    WORD_T_ B = 0;

    assert(NULL != S);

    xmemset(S, 0, sizeof(WORD_T_) * TAB_SIZE);
