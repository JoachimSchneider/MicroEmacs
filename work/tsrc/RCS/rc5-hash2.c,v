static VOID RC5_ENCRYPT(WORD_T_ *pt,  /* 2 Word input pt  */
                        WORD_T_ *ct   /* 2 Word output ct */
                       )
{
    static int      valid = FALSE;  /* boolean: data have been set      */
    static WORD_T_  S[TAB_SIZE];    /* expanded key table               */

