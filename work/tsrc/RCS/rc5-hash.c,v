#define BYTE_BITS      (8)    /* Bits In Byte */
#define T_MAX         (64)
#define C_1            1
#define C_2            2
#define C_3            3
#define C_4            4
#define C_8            8
#define C_16          16
#define C_32          32
#define FALSE         (0)
